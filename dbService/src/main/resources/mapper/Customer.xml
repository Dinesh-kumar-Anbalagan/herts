<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="Customer">
    <resultMap id="CustomerResultMap" type="com.herts.model.Customer">
    <result property="customerID" column="customerID"/>
    <result property="accountNumber" column="accountNumber"/>
        <result property="status" column="status"/>
        <result property="firstName" column="firstName"/>
        <result property="lastName" column="lastName"/>
        <result property="phoneNumber" column="phoneNumber"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="role" column="role"/>
    <association property="address" javaType="com.herts.model.Address">
        <result property="address" column="address"/>
        <result property="country" column="country"/>
        <result property="postalCode" column="postal_code"/>
        <result property="county" column="county"/>
    </association>
    </resultMap>

    <select id="findById" resultMap="CustomerResultMap" parameterType="com.herts.model.Customer">
        SELECT * FROM herts_shipment.customer
        WHERE email = #{email};
    </select>

    <select id="getDataId" resultMap="CustomerResultMap" parameterType="com.herts.model.Customer">
        SELECT * FROM herts_shipment.customer
        WHERE customerID = #{customerID};
    </select>

    <insert id="insert" parameterType="com.herts.model.Customer">
        INSERT INTO herts_shipment.customer ( customerID, accountNumber,
        status,
        firstName,
        lastName,
        phoneNumber,
        password,
        email,
        role )
        VALUES ( #{customerID}, #{accountNumber}, #{status}, #{firstName}, #{lastName}, #{phoneNumber},
        #{password}, #{email}, #{role} )
    </insert>

    <update id="update" parameterType="com.herts.model.Customer">
        UPDATE customer
        SET customerID = #{customerID} , accountNumber = #{accountNumber},
        status = #{status},
        firstName =  #{firstName},
        lastName = #{lastName},
        phoneNumber = #{phoneNumber},
        password = #{password},
        email = #{email},
        role = #{role},
        address = #{address.address},
        country = #{address.country},
        postal_code = #{address.postalCode},
        county = #{address.county}
        WHERE customerID = #{customerID}
    </update>
</mapper>