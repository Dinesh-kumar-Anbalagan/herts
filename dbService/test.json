{"bio_Samples":[{"name":"SAMD01688403","accession":"SAMD01688403","sraAccession":"DRS524548","webinSubmissionAccountId":"Webin-40894","taxId":10090,"status":"PUBLIC","release":"2025-09-26T00:00:00Z","update":"2025-09-29T02:30:40.912Z","submitted":"2025-09-27T01:01:30.660Z","characteristics":{"External Id":[{"text":"SAMD01688403","tag":"Namespace:BioSample"}],"INSDC center name":[{"text":"Department of Ophthalmology, National Defense Medical College"}],"INSDC first public":[{"text":"2025-09-26T00:00:00Z"}],"INSDC last update":[{"text":"2025-09-28T02:18:19.240Z"}],"INSDC secondary accession":[{"text":"DRS524548"}],"INSDC status":[{"text":"live"}],"NCBI submission model":[{"text":"Generic"}],"NCBI submission package":[{"text":"Generic.1.0"}],"SRA accession":[{"text":"DRS524548"}],"age":[{"text":"12_weeks","tag":"attribute"}],"biomaterial_provider":[{"text":"Japan SLC","tag":"attribute"}],"cell_type":[{"text":"retinal cells","tag":"attribute"}],"collection_date":[{"text":"2021-12-21","tag":"attribute"}],"description":[{"text":"This sample consists of retinal single cells isolated from the retinas of streptozotocin (STZ)-induced C57BL/6J (B6) mice that were immunized to induce experimental autoimmune uveoretinitis (EAU) using human IRBP 1-20 (STZ-EAU). The sample preparation method is described in detail in the following reference: https://doi.org/10.3390/biomedicines13092049. Briefly, five-week-old female B6 mice were intraperitoneally administered 60 mg/kg of STZ for five consecutive days. Four weeks after the first injection, mice with blood glucose levels of 300 mg/dL or higher were used as diabetic mice. For EAU induction, the B6 mice were immunized at nine weeks of age by subcutaneous injection in the lumbar region with an emulsion of human IRBP 1-20 in PBS and CFA. To enhance the immune response, pertussis toxin was administered intraperitoneally. Three weeks post-immunization, the mice were euthanized and their retinas were enucleated. The retinas were then enzymatically digested with papain to obtain single-cell suspensions. Rod cells were subsequently removed using magnetic beads targeting CD73, and single-cell RNA sequencing was performed on the remaining retinal cells."}],"disease":[{"text":"Diabetes and experimental autoimmune uveoretinitis","tag":"attribute"}],"geo_loc_name":[{"text":"Japan","tag":"attribute"}],"organism":[{"text":"Mus musculus","ontologyTerms":["http://purl.obolibrary.org/obo/NCBITaxon_10090"]}],"sample_name":[{"text":"STZ-EAU","tag":"attribute"}],"sex":[{"text":"female","tag":"attribute"}],"strain":[{"text":"C57BL6J","tag":"attribute"}],"tissue":[{"text":"retina","tag":"attribute"}],"title":[{"text":"STZ-EAU"}]},"externalReferences":[{"url":"https://www.ebi.ac.uk/ena/browser/view/SAMD01688403","duo":[]}],"submittedVia":"PIPELINE_IMPORT","create":"2025-09-27T01:01:30.660Z","_links":{"self":{"href":"https://wwwdev.ebi.ac.uk/biosamples/samples/SAMD01688403"},"applyCurations":{"href":"https://wwwdev.ebi.ac.uk/biosamples/samples/SAMD01688403{?applyCurations}","templated":true},"curationLinks":{"href":"https://wwwdev.ebi.ac.uk/biosamples/samples/SAMD01688403/curationlinks"},"curationLink":{"href":"https://wwwdev.ebi.ac.uk/biosamples/samples/SAMD01688403/curationlinks/{hash}","templated":true},"structuredData":{"href":"https://wwwdev.ebi.ac.uk/biosamples/structureddata/SAMD01688403"}}},{"name":"3979-2800","accession":"SAMN50488397","webinSubmissionAccountId":"Webin-40894","taxId":9606,"status":"PUBLIC","release":"2025-08-07T03:08:50.103Z","update":"2025-09-29T00:48:42.250Z","submitted":"2025-08-07T03:08:50.103Z","characteristics":{"External Id":[{"text":"SAMN50488397","tag":"Namespace:BioSample"}],"INSDC center name":[{"text":"dbGaP"}],"INSDC first public":[{"text":"2025-08-07T03:08:50.103Z"}],"INSDC last update":[{"text":"2025-09-26T06:21:29.490Z"}],"INSDC status":[{"text":"live"}],"NCBI submission model":[{"text":"Generic"}],"NCBI submission package":[{"text":"Generic.1.0"}],"analyte type":[{"text":"DNA"